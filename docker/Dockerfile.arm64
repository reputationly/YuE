# YuE2 —— ARM64 / A100 引擎镜像(GPUStack 内置后端 YuE2)
#
# 叠在 LightX2V 的共享 cu130 基座上,与 ACE-Step / IndexTTS 同一套做法:
#   - PyPI 的 aarch64 torch 是 CPU 轮子,集群机器上 download.pytorch.org 又只有
#     ~50 KB/s,所以带 CUDA 的 aarch64 torch 只能从一个已经装好的基座里继承。
#   - 基座 = Python 3.12.13 + torch 2.11.0+cu130 + ffmpeg(含 libmp3lame)。
#
# 与上游 pyproject 的版本差异(有意为之):
#   torch 2.10.0 -> 继承基座 2.11.0。YuE2 在 2.13 上实测同 seed 逐 token 复现
#                  (abc 549 / semantic 1584),2.11 夹在中间。
#   numpy / accelerate / soundfile -> 继承基座(均为更新的小版本,API 未变)。
#   其余照上游钉:transformers 4.57.6、huggingface-hub 0.36.2、tiktoken 0.12.0、
#   safetensors 0.7.0。transformers 必须钉:基座是 5.15,而 YuE2 的
#   from_pretrained(torch_dtype=...) 与 DynamicCache 用法是 4.x 的。
#
# 翻唱(SheetSage2 扒谱)只多三个纯 Python 包:pretty_midi / mido / mir_eval。
# SheetSage2 自己钉的 torch 2.8 / transformers 4.45 / numpy 1.24 是作者环境的快照,
# 不是硬要求 —— 它在本镜像的 torch 2.11 / transformers 4.57.6 / numpy 2.5 上原样
# 跑通(A100 实测)。numpy 1.24 连 Python 3.12 的轮子都没有,照钉就得另起一套 3.11。
# 模型代码与权重不进镜像,跟 YuE2 权重一起放在模型目录(SheetSage2/、MERT-v2-FullSong/)。
#
# 构建:
#   docker build -f docker/Dockerfile.arm64 -t yue2:arm64-a100 .
# 在集群机器上本地构建时 PyPI 不通(pypi.org 实测 1 MB/15 s),要换源:
#   --build-arg PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# CI 出包走 .github/workflows/build-arm64.yml(runner 在境外,base 从 Docker Hub 拉)。
ARG BASE_IMAGE=crpi-xzr81d0490mc3794.cn-shanghai.personal.cr.aliyuncs.com/reputationly/lightx2v:arm64-cu130-a100-base
FROM ${BASE_IMAGE}

# 只作用于构建期的 pip;不进镜像的运行环境。
ARG PIP_INDEX_URL=https://pypi.org/simple

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/opt/yue2 \
    TOKENIZERS_PARALLELISM=false \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_XET=1

WORKDIR /opt/yue2

# 依赖层先于源码层:改代码只重跑后两层。
# torch 冻结成 constraints —— 任何一次 pip 都不许把它换成 PyPI 的 CPU 轮子。
# numpy/scipy 一并冻结:mir_eval 这类旧包的宽约束不许把基座的 numpy 2.x 换掉。
RUN python3 -m pip freeze | grep -iE '^(torch|torchvision|torchaudio|numpy|scipy)==' > /opt/torch-constraints.txt \
    && echo "=== frozen from base ===" && cat /opt/torch-constraints.txt \
    && python3 -m pip install -c /opt/torch-constraints.txt \
        "transformers==4.57.6" \
        "huggingface-hub==0.36.2" \
        "tiktoken==0.12.0" \
        "safetensors==0.7.0" \
        "pretty_midi==0.2.10" \
        "mido==1.3.3" \
        "mir_eval==0.8.2" \
        "pytest>=8.0"

COPY . /opt/yue2
RUN python3 -m pip install --no-deps /opt/yue2

# 构建期断言:版本钉对、CUDA 编译进去了、整条导入链完整、契约测试全过。
# 放这里是为了让"镜像能起但一请求就崩"在出包阶段暴露,而不是等实例部署完。
RUN python3 docker/smoke_check_arm64.py \
    && python3 -m pytest -q tests/test_harness_task_api.py tests/test_protocol.py

EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
